# Local-only values for the automated test suite. Points at the separate tutora_test database.
NODE_ENV=test
PORT=0
LOG_LEVEL=silent
TRUST_PROXY=false
DATABASE_URL=postgres://tutora:tutora@localhost:5432/tutora_test
REDIS_URL=redis://localhost:6379/1
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tutora
S3_SECRET_ACCESS_KEY=tutora-dev-secret
S3_BUCKET=tutora-test
S3_FORCE_PATH_STYLE=true
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
JWT_ACCESS_SECRET=test-only-secret-that-is-at-least-32-characters-long
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
IDEMPOTENCY_TTL_HOURS=24
ADMIN_EMAIL=admin@test.local
ADMIN_PASSWORD=test-admin-password
ADMIN_FULL_NAME=Test Admin
