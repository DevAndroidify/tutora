# ---------- Runtime ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set to true only when running behind a trusted reverse proxy.
TRUST_PROXY=false

# ---------- PostgreSQL ----------
DATABASE_URL=postgres://tutora:tutora@localhost:5432/tutora

# ---------- Redis ----------
REDIS_URL=redis://localhost:6379/0

# ---------- S3-compatible storage (MinIO locally) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=tutora
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET=tutora-dev
S3_FORCE_PATH_STYLE=true

# ---------- LiveKit ----------
LIVEKIT_URL=http://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me

# ---------- Auth ----------
# At least 32 random characters. Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-of-32-chars-or-more
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
LOGIN_RATE_LIMIT_MAX=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
IDEMPOTENCY_TTL_HOURS=24

# ---------- Learning requests, uploads, rate limits ----------
REQUEST_TTL_HOURS=72
UPLOAD_MAX_BYTES=10485760
UPLOAD_URL_TTL_SECONDS=300
POSTING_RATE_LIMIT_MAX=20
POSTING_RATE_LIMIT_WINDOW_SECONDS=3600
BIDDING_RATE_LIMIT_MAX=60
BIDDING_RATE_LIMIT_WINDOW_SECONDS=3600

# ---------- Outbox ----------
OUTBOX_POLL_INTERVAL_MS=500
OUTBOX_MAX_ATTEMPTS=10

# ---------- Sessions, recordings, quizzes ----------
SESSION_JOIN_EARLY_MINUTES=15
SESSION_TOKEN_TTL_SECONDS=600
RECORDING_RETENTION_DAYS=30
RECORDING_S3_ENDPOINT=http://minio:9000
QUIZ_QUESTIONS=5
QUIZ_PASS_PERCENT=60
WHITEBOARD_SNAPSHOT_LIMIT=50
POOL_SIMILARITY_THRESHOLD=0.5
POOL_INVITE_TTL_HOURS=24
POOL_PAYMENT_WINDOW_MINUTES=60

# ---------- Observability and HTTP (Part 20) ----------
# If set, GET /metrics requires "Authorization: Bearer <token>".
# METRICS_TOKEN=change-me-to-a-long-random-token
OTEL_ENABLED=false
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Comma-separated browser origins allowed to call the API (frontends). Empty = same-origin only.
CORS_ORIGINS=

# ---------- Seed admin (used by `yarn db:seed`) ----------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=Platform Admin

# ---------- Marketplace defaults ----------
PAYMENT_WINDOW_MINUTES=15
DISPUTE_WINDOW_HOURS=24
NO_SHOW_GRACE_MINUTES=10
POOL_MAX_SEATS=5
RECHECK_DAYS=7
MASTERY_K=10
MASTERY_MIN_ATTEMPTS=10
PLATFORM_FEE_BPS=1000
EMBEDDING_DIM=1024
HOLD_MODE=ledger_only
UPI_PROVIDER=fake

# ---------- Payments (TEST MODE ONLY; never real money) ----------
FAKE_UPI_WEBHOOK_SECRET=fake-upi-dev-webhook-secret
# Razorpay test keys from Dashboard > Test Mode > API Keys. Live keys (rzp_live_) are refused.
# Only needed when UPI_PROVIDER=razorpay.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your_test_key_secret
# RAZORPAY_WEBHOOK_SECRET=your_test_webhook_secret
